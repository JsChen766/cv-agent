# ============================================================================
# 生产 / 公网测试环境变量模板
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.prod.example .env.prod
#   然后填好下方所有标记 <CHANGE_ME> 的值。
#   密钥生成：openssl rand -hex 32
#
# 安全约束（由后端配置守卫强制，违反会启动失败）：
#   - APP_ENV=production 时禁止开发密码登录
#   - SYNC_CURSOR_SIGNING_KEY / OTP_HASH_KEY 必须 >= 32 字节
#   - .env.prod 已被 .gitignore 忽略，绝不可提交
# ============================================================================

APP_ENV=production

# --- HTTP ---
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# API 对外绑定。若前面有反向代理终止 HTTPS，建议改成 API_BIND=127.0.0.1，
# 让 API 只监听本机，仅由反代访问；防火墙只放行 443。
API_BIND=0.0.0.0
API_PORT=8080

# --- PostgreSQL ---
# 用强随机密码替换 <CHANGE_ME>。生产建议使用托管数据库并设 sslmode=require。
POSTGRES_DB=cv_agent
POSTGRES_USER=cv_agent
POSTGRES_PASSWORD=<CHANGE_ME_strong_db_password>
POSTGRES_PORT=5432
DATABASE_URL=postgres://cv_agent:<CHANGE_ME_strong_db_password>@postgres:5432/cv_agent?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# --- Redis ---
# 生产必须设密码；本编排已用 --requirepass 强制。
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=<CHANGE_ME_strong_redis_password>
REDIS_DB=0
REDIS_PORT=6379

# --- Sync（游标签名）---
# openssl rand -hex 32
SYNC_CURSOR_SIGNING_KEY=<CHANGE_ME_at_least_32_bytes>
SYNC_CURSOR_MAX_AGE=4320h

# --- OTP ---
# openssl rand -hex 32
OTP_HASH_KEY=<CHANGE_ME_at_least_32_bytes>
OTP_TTL=10m
OTP_RESEND_AFTER=60s
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW=15m
OTP_EMAIL_SEND_LIMIT=5
OTP_DEVICE_SEND_LIMIT=10
OTP_IP_SEND_LIMIT=20
OTP_VERIFY_LIMIT=10

# --- 邮件 ---
# 测试用 mailpit：不真实发信，OTP 验证码在 mailpit 面板查看。
# mailpit 面板只绑 127.0.0.1，通过 SSH 隧道访问：
#   ssh -L 8025:127.0.0.1:8025 user@服务器IP  然后浏览器开 http://localhost:8025
EMAIL_PROVIDER=mailpit
SMTP_ADDRESS=mailpit:1025
EMAIL_SENDER_ADDRESS=no-reply@coolto.local
EMAIL_SENDER_NAME=CV Agent
MAILPIT_UI_PORT=8025

# 若改用真实发信，把 EMAIL_PROVIDER 改为 brevo 并填下面几项：
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CV Agent
BREVO_REPLY_TO=

# --- 开发登录（生产必须 false，否则启动失败）---
ENABLE_DEV_PASSWORD_LOGIN=false
