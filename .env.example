APP_ENV=local
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=cv_agent
POSTGRES_USER=cv_agent
POSTGRES_PASSWORD=cv_agent_dev
POSTGRES_PORT=15432
DATABASE_URL=postgres://cv_agent:cv_agent_dev@postgres:5432/cv_agent?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

SYNC_CURSOR_SIGNING_KEY=local-only-sync-cursor-signing-key
SYNC_CURSOR_MAX_AGE=4320h

SMTP_ADDRESS=mailpit:1025
EMAIL_SENDER_ADDRESS=no-reply@coolto.local
EMAIL_SENDER_NAME=Coolto
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
OTP_HASH_KEY=local-only-otp-hash-key-change-before-production
OTP_TTL=10m
OTP_RESEND_AFTER=60s
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW=15m
OTP_EMAIL_SEND_LIMIT=5
OTP_DEVICE_SEND_LIMIT=10
OTP_IP_SEND_LIMIT=20
OTP_VERIFY_LIMIT=10

# Brevo transactional email (production OTP sender)
# Keep BREVO_API_KEY only in the ignored local .env or deployment secret store.
EMAIL_PROVIDER=mailpit
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CV Agent
BREVO_REPLY_TO=

API_PORT=8080

ENABLE_DEV_PASSWORD_LOGIN=true
